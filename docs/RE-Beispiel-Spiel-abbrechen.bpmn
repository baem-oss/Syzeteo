<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Syzeteo_US26" targetNamespace="https://github.com/baem-oss/Syzeteo">
  <bpmn:collaboration id="Collaboration_US26"><bpmn:participant id="Participant_Process" name="Spiel abbrechen (US #26)" processRef="Process_US26"/></bpmn:collaboration>
  <bpmn:process id="Process_US26" name="Spiel abbrechen" isExecutable="false">
    <bpmn:laneSet id="LaneSet_US26">
      <bpmn:lane id="Lane_Instructor" name="Instructor"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Decide</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef><bpmn:flowNodeRef>Cancel</bpmn:flowNodeRef><bpmn:flowNodeRef>EndNo</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_System" name="Syzeteo"><bpmn:flowNodeRef>Ask</bpmn:flowNodeRef><bpmn:flowNodeRef>Abort</bpmn:flowNodeRef><bpmn:flowNodeRef>Success</bpmn:flowNodeRef><bpmn:flowNodeRef>Notice</bpmn:flowNodeRef><bpmn:flowNodeRef>Navigate</bpmn:flowNodeRef><bpmn:flowNodeRef>EndYes</bpmn:flowNodeRef><bpmn:flowNodeRef>Error</bpmn:flowNodeRef><bpmn:flowNodeRef>EndError</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Abbruch ausgelöst"><bpmn:outgoing>f1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Ask" name="Bestätigung anfordern"><bpmn:incoming>f1</bpmn:incoming><bpmn:outgoing>f2</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="Decide" name="Abbruch bestätigen oder verwerfen"><bpmn:incoming>f2</bpmn:incoming><bpmn:outgoing>f3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Confirm" name="Bestätigt?"><bpmn:incoming>f3</bpmn:incoming><bpmn:outgoing>f4</bpmn:outgoing><bpmn:outgoing>f6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Cancel" name="Abfrage schließen"><bpmn:incoming>f4</bpmn:incoming><bpmn:outgoing>f5</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndNo" name="Abbruch verworfen"><bpmn:incoming>f5</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Abort" name="Spiel abbrechen"><bpmn:incoming>f6</bpmn:incoming><bpmn:outgoing>f7</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="Success" name="Abbruch erfolgreich?"><bpmn:incoming>f7</bpmn:incoming><bpmn:outgoing>f8</bpmn:outgoing><bpmn:outgoing>f11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="Notice" name="Abbruch bestätigen"><bpmn:incoming>f8</bpmn:incoming><bpmn:outgoing>f9</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Navigate" name="Instructor-Seite öffnen"><bpmn:incoming>f9</bpmn:incoming><bpmn:outgoing>f10</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndYes" name="Spiel abgebrochen"><bpmn:incoming>f10</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="Error" name="Fehler melden"><bpmn:incoming>f11</bpmn:incoming><bpmn:outgoing>f12</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="EndError" name="Abbruch fehlgeschlagen"><bpmn:incoming>f12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="Ask"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Ask" targetRef="Decide"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Decide" targetRef="Confirm"/>
    <bpmn:sequenceFlow id="f4" sourceRef="Confirm" targetRef="Cancel" name="Nein"/>
    <bpmn:sequenceFlow id="f5" sourceRef="Cancel" targetRef="EndNo"/>
    <bpmn:sequenceFlow id="f6" sourceRef="Confirm" targetRef="Abort" name="Ja"/>
    <bpmn:sequenceFlow id="f7" sourceRef="Abort" targetRef="Success"/>
    <bpmn:sequenceFlow id="f8" sourceRef="Success" targetRef="Notice" name="Ja"/>
    <bpmn:sequenceFlow id="f9" sourceRef="Notice" targetRef="Navigate"/>
    <bpmn:sequenceFlow id="f10" sourceRef="Navigate" targetRef="EndYes"/>
    <bpmn:sequenceFlow id="f11" sourceRef="Success" targetRef="Error" name="Nein"/>
    <bpmn:sequenceFlow id="f12" sourceRef="Error" targetRef="EndError"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_US26"><bpmndi:BPMNPlane id="Plane_US26" bpmnElement="Collaboration_US26">
    <bpmndi:BPMNShape id="ParticipantShape" bpmnElement="Participant_Process" isHorizontal="true"><dc:Bounds x="90" y="90" width="1680" height="440"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="InstructorShape" bpmnElement="Lane_Instructor" isHorizontal="true"><dc:Bounds x="120" y="90" width="1650" height="185"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="SystemShape" bpmnElement="Lane_System" isHorizontal="true"><dc:Bounds x="120" y="275" width="1650" height="255"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Start" bpmnElement="Start"><dc:Bounds x="170" y="164" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Ask" bpmnElement="Ask"><dc:Bounds x="280" y="317" width="160" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Decide" bpmnElement="Decide"><dc:Bounds x="500" y="145" width="160" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Confirm" bpmnElement="Confirm"><dc:Bounds x="730" y="157" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Cancel" bpmnElement="Cancel"><dc:Bounds x="850" y="145" width="155" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_EndNo" bpmnElement="EndNo"><dc:Bounds x="1100" y="164" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Abort" bpmnElement="Abort"><dc:Bounds x="850" y="315" width="155" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Success" bpmnElement="Success"><dc:Bounds x="1080" y="327" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Notice" bpmnElement="Notice"><dc:Bounds x="1225" y="300" width="145" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Navigate" bpmnElement="Navigate"><dc:Bounds x="1440" y="300" width="155" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_EndYes" bpmnElement="EndYes"><dc:Bounds x="1680" y="318" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Error" bpmnElement="Error"><dc:Bounds x="1225" y="420" width="145" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_EndError" bpmnElement="EndError"><dc:Bounds x="1440" y="440" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_f1" bpmnElement="f1"><di:waypoint x="206" y="182"/><di:waypoint x="240" y="182"/><di:waypoint x="240" y="354"/><di:waypoint x="280" y="354"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f2" bpmnElement="f2"><di:waypoint x="440" y="354"/><di:waypoint x="473" y="354"/><di:waypoint x="473" y="182"/><di:waypoint x="500" y="182"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f3" bpmnElement="f3"><di:waypoint x="660" y="182"/><di:waypoint x="730" y="182"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f4" bpmnElement="f4"><di:waypoint x="780" y="182"/><di:waypoint x="850" y="182"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f5" bpmnElement="f5"><di:waypoint x="1005" y="182"/><di:waypoint x="1100" y="182"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f6" bpmnElement="f6"><di:waypoint x="755" y="207"/><di:waypoint x="755" y="352"/><di:waypoint x="850" y="352"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f7" bpmnElement="f7"><di:waypoint x="1005" y="352"/><di:waypoint x="1080" y="352"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f8" bpmnElement="f8"><di:waypoint x="1130" y="352"/><di:waypoint x="1175" y="352"/><di:waypoint x="1175" y="337"/><di:waypoint x="1225" y="337"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f9" bpmnElement="f9"><di:waypoint x="1370" y="337"/><di:waypoint x="1440" y="337"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f10" bpmnElement="f10"><di:waypoint x="1595" y="337"/><di:waypoint x="1680" y="336"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f11" bpmnElement="f11"><di:waypoint x="1105" y="377"/><di:waypoint x="1105" y="457"/><di:waypoint x="1225" y="457"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Edge_f12" bpmnElement="f12"><di:waypoint x="1370" y="457"/><di:waypoint x="1440" y="458"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
